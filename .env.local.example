# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Bildirimlerin gideceği adres (senin / şirket mailin)
CONTACT_EMAIL_TO=info@omafil.com

# Gönderen adres — Resend’de doğrulanmış domain olmalı
# Test için: OmaFil <onboarding@resend.dev> (yalnızca kendi hesabına yollar)
# Prod: OmaFil <noreply@omafil.com>
CONTACT_EMAIL_FROM=OmaFil <onboarding@resend.dev>

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Boş bırakılabilir (lokalde atlanır). Widget için gerçek key lazım.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# keystatic panel - tek hesap. ben ve patronlar aynı ad ve şifre kullansın. 
# gerçek şifre sadece .env.local içinde 
KEYSTATIC_SESSION_SECRET=
KEYSTATIC_USER=
KEYSTATIC_PASSWORD=

# Canlı panelin GitHub'a yazması. Değerler /keystatic kurulum ekranından gelir.
# KEYSTATIC_SESSION_SECRET ile karıştırma. Bu üçü ayrı.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Cloudflare Turnstile - https://dash.cloudflare.com -> Turnstile
# yerelde boş bırakılabilir(form atlanır). canlıda ikisi de dolu olmalı
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# gemini api key
GEMINI_API_KEY=

# omafil ai sohbet database i
DATABASE_URL=postgresql://neondb_owner:npg_UqtNQXnf0v3w@ep-aged-hall-b16cb5pf-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
